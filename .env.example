# ---------------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development and fill in the DEV values.
# `.env` is git-ignored, so credentials never get committed.
#
# Two databases are used:
#   - DEV  -> local development (`npm run dev`, `prisma migrate dev`)
#   - PROD -> Vercel deployment (set in the Vercel dashboard)
#
# Both use Neon PostgreSQL. Each Neon database exposes two connection strings:
#   - a POOLED url      -> DATABASE_URL (used by the app at runtime)
#   - a DIRECT url      -> DIRECT_URL   (used by Prisma migrations)
# You can find both in the Neon dashboard under "Connection Details".
# ---------------------------------------------------------------------------

# Pooled connection (app runtime). Add `?sslmode=require&pgbouncer=true`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection (Prisma migrations). No `-pooler`, no pgbouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
